{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "GOAT_VESC_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "default",
      "inherits": "base"
    },
    {
      "name": "strict-analysis",
      "inherits": "base",
      "cacheVariables": {
        "GOAT_VESC_ENABLE_CLANG_TIDY": "ON",
        "GOAT_VESC_ENABLE_CPPCHECK": "ON",
        "GOAT_VESC_ENABLE_WERROR": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "inherits": "base",
      "cacheVariables": {
        "GOAT_VESC_ENABLE_WERROR": "ON",
        "GOAT_VESC_ENABLE_ASAN": "ON",
        "GOAT_VESC_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "cacheVariables": {
        "GOAT_VESC_ENABLE_WERROR": "ON",
        "GOAT_VESC_ENABLE_TSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "strict-analysis",
      "configurePreset": "strict-analysis"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "strict-analysis",
      "configurePreset": "strict-analysis",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
